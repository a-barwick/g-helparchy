{
  "schemaVersion": 1,
  "id": "io.github.a-barwick.asus",
  "name": "ASUS",
  "version": "2.1.0",
  "author": "a-barwick, moneytosms",
  "license": "MIT",
  "homepage": "https://github.com/a-barwick/omarchy-asus",
  "description": "ASUS laptop controls for Omarchy: GPU modes, sensors, power profiles, keyboard lighting, and fan curves",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "ASUS",
    "description": "GPU modes, sensors, power profiles, keyboard lighting, fan curves, and battery charge limits for ASUS laptops",
    "category": "System",
    "aliases": ["asus", "rog", "tuf", "aura", "fan", "rgb", "lighting", "gpu", "temp", "ghelper"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showBatteryLimit": true,
      "refreshIntervalSec": 10
    },
    "schema": [
      {
        "key": "showBatteryLimit",
        "type": "boolean",
        "label": "Show battery charge limit",
        "defaultValue": true
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 60,
        "step": 5,
        "defaultValue": 10
      }
    ]
  }
}
